# Server-only token from https://yce.makeupar.com/api-console/en/api-keys/
YOUCAM_API_KEY=

# Leave unset to use Perfect Corp's documented API host.
YOUCAM_API_BASE_URL=https://yce-api-01.makeupar.com

# Optional experimental reference-photo makeup transfer endpoint enabled for your account.
YOUCAM_MAKEUP_TRANSFER_SLUG=

# Cross-device account storage and session signing.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
BETTER_AUTH_SECRET=generate_a_random_secret_at_least_32_characters_long
BETTER_AUTH_URL=http://localhost:3000

# Added automatically when a Vercel Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=provided_by_your_vercel_blob_store
